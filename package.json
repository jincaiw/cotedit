{
  "name": "cotedit-desktop",
  "version": "1.0.7",
  "description": "An independent cross-platform text and source-code editor inspired by CotEditor.",
  "author": "CotEdit contributors",
  "homepage": "https://github.com/jincaiw/cotedit",
  "repository": {
    "type": "git",
    "url": "https://github.com/jincaiw/cotedit.git"
  },
  "bugs": {
    "url": "https://github.com/jincaiw/cotedit/issues"
  },
  "desktopName": "CotEdit",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test test/*.test.js",
    "test:ui": "npm run build && node --test test/electron-ui-smoke.cjs",
    "test:ui:themes": "npm run build && node --test --test-name-pattern='Electron custom editor themes' test/electron-ui-smoke.cjs",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron .",
    "package:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "package:windows": "npm run build && electron-builder --win nsis --publish never",
    "package:mac": "npm run build && electron-builder --mac dmg zip --publish never"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "chardet": "^2.2.0",
    "codemirror": "^6.0.2",
    "iconv-lite": "^0.7.3",
    "json5": "^2.2.3"
  },
  "devDependencies": {
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.cotedit.desktop",
    "productName": "CotEdit",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*.cjs",
      "lib/recent-documents.cjs",
      "lib/shortcuts.js",
      "lib/toolbar-items.js",
      "lib/snippets.js",
      "lib/file-drop-defaults.json",
      "lib/settings.js",
      "lib/settings-file.js",
      "lib/custom-editor-themes.js",
      "lib/multiple-replace.js",
      "lib/shortcuts.json",
      "lib/icu-regexp.js",
      "docs/licenses/UNICODE-LICENSE-V3.txt",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "fileAssociations": [
        {
          "ext": [
            "bib",
            "c",
            "c++",
            "cc",
            "cls",
            "command",
            "conf",
            "cp",
            "cpp",
            "cs",
            "css",
            "cxx",
            "d",
            "dart",
            "dif",
            "diff",
            "dtd",
            "f",
            "f03",
            "f08",
            "f90",
            "f95",
            "for",
            "geojson",
            "go",
            "h",
            "h++",
            "hh",
            "hp",
            "hpp",
            "hs",
            "htm",
            "html",
            "hxx",
            "ini",
            "ipp",
            "jav",
            "java",
            "jl",
            "js",
            "json",
            "kt",
            "kts",
            "lhs",
            "lisp",
            "lsp",
            "lua",
            "markdown",
            "md",
            "mdown",
            "mkd",
            "mkdn",
            "mojo",
            "mysql",
            "patch",
            "pgsql",
            "php",
            "php3",
            "php4",
            "php5",
            "phps",
            "phtml",
            "pl",
            "pm",
            "py",
            "pyw",
            "rb",
            "rc",
            "rest",
            "rs",
            "rst",
            "scala",
            "scm",
            "sh",
            "sql",
            "ss",
            "sty",
            "svg",
            "swift",
            "tex",
            "textile",
            "toml",
            "txt",
            "v",
            "vhd",
            "xml",
            "xsd",
            "xsl",
            "xslt",
            "yaml",
            "yml"
          ],
          "name": "Text document",
          "role": "Editor",
          "rank": "Default"
        }
      ],
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "CotEdit-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "CotEdit-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Development;TextEditor;",
      "icon": "build/icon.png",
      "mimeTypes": [
        "application/geo+json",
        "application/json",
        "application/sql",
        "application/toml",
        "application/vnd.dart",
        "application/x-perl",
        "application/x-php",
        "application/x-ruby",
        "application/x-shellscript",
        "application/xml",
        "application/xml-dtd",
        "application/xslt+xml",
        "application/yaml",
        "image/svg+xml",
        "text/css",
        "text/html",
        "text/javascript",
        "text/julia",
        "text/markdown",
        "text/plain",
        "text/rust",
        "text/x-bibtex",
        "text/x-c++hdr",
        "text/x-c++src",
        "text/x-chdr",
        "text/x-common-lisp",
        "text/x-csharp",
        "text/x-dsrc",
        "text/x-fortran",
        "text/x-go",
        "text/x-haskell",
        "text/x-java",
        "text/x-kotlin",
        "text/x-literate-haskell",
        "text/x-lua",
        "text/x-patch",
        "text/x-python",
        "text/x-rst",
        "text/x-scala",
        "text/x-scheme",
        "text/x-tex",
        "text/x-verilog",
        "text/x-vhdl"
      ],
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "CotEdit-${version}-linux-${arch}.${ext}",
      "maintainer": "CotEdit contributors"
    }
  }
}
